# Private deployment values. Replace every REPLACE_ME before use.
# The program reads process environment; it does not automatically load this file.
ZEPHYR_DATA_DIR=./data
MCP_PUBLIC_BASE_URL=https://mcp.example.com
MCP_PORT=8765
GITHUB_CLIENT_ID=REPLACE_ME
GITHUB_CLIENT_SECRET=REPLACE_ME
GITHUB_ALLOWED_USER_IDS=REPLACE_ME
FASTMCP_JWT_SIGNING_KEY=REPLACE_ME
OAUTH_STORAGE_FERNET_KEY=REPLACE_ME
CONTEXT_TOKEN_SIGNING_KEY=REPLACE_ME
DASHSCOPE_API_KEY=REPLACE_ME
ALIYUN_WORKSPACE_ID=REPLACE_ME
ASR_PROVIDER=aliyun
ASR_ENGINE=paraformer-v2
ASR_REGION=cn-beijing
FASTMCP_WORKERS=1
ASR_MAX_CONCURRENCY=1
ASR_ALLOW_PAID=false
# Set true only after confirming Auto-Stop for this account/model in the console.
ALIYUN_FREE_TIER_ONLY_CONFIRMED=false
ASR_MONTHLY_MAX_SECONDS=36000
ASR_QUOTA_SYNC_INTERVAL_SECONDS=300
ASR_QUOTA_STALE_SECONDS=1800
ASR_MAX_VIDEO_SECONDS=10800
ASR_CACHE_TTL_DAYS=30
ASR_ENABLE_TRANSCODE=false
# Optional dedicated QR credentials; keep the file private, mode 600.
# BILIBILI_CREDENTIALS_FILE=./data/bilibili-credentials.json
# BILIBILI_COOKIE=REPLACE_ME
